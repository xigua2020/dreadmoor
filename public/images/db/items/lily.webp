"12" y1="1" x2="12" y2="3" data-astro-cid-l6lhmie6></line><line x1="12" y1="21" x2="12" y2="23" data-astro-cid-l6lhmie6></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" data-astro-cid-l6lhmie6></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" data-astro-cid-l6lhmie6></line><line x1="1" y1="12" x2="3" y2="12" data-astro-cid-l6lhmie6></line><line x1="21" y1="12" x2="23" y2="12" data-astro-cid-l6lhmie6></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" data-astro-cid-l6lhmie6></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" data-astro-cid-l6lhmie6></line></svg></span><span class="icon-moon" aria-hidden="true" data-astro-cid-l6lhmie6><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-astro-cid-l6lhmie6><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" data-astro-cid-l6lhmie6></path></svg></span></button><script>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isLight = document.documentElement.dataset.theme === 'light';
      const target = isLight ? 'dark' : 'light';
      document.documentElement.dataset.theme = target;
      try {
        localStorage.setItem('theme', target);
      } catch {}
    });
  })();
</script></div></div><!-- Desktop navigation bar (>= 992px) --><nav class="site-nav" aria-label="Main Navigation" data-astro-cid-nen7h5rs><div class="wrap nav-inner" data-astro-cid-nen7h5rs><ul class="nav-list" data-astro-cid-nen7h5rs><li class="nav-item" data-astro-cid-nen7h5rs><a href="/" class="nav-link active" aria-current="page" data-astro-cid-nen7h5rs>Home</a></li><li class="nav-item" data-astro-cid-nen7h5rs><a href="/fish/" class="nav-link" data-astro-cid-nen7h5rs>Fish</a></li><li class="nav-item" data-astro-cid-nen7h5rs><a href="/items/" class="nav-link" data-astro-cid-nen7h5rs>Items</a></li><li class="nav-item" data-astro-cid-nen7h5rs><a href="/upgrades/" class="nav-link" data-astro-cid-nen7h5rs>Upgrades</a></li><li class="nav-item" data-astro-cid-nen7h5rs><a href="/map/" class="nav-link" data-astro-cid-nen7h5rs>Map</a></li><li class="nav-item" data-astro-cid-nen7h5rs><a href="/news/" class="nav-link" data-astro-cid-nen7h5rs>News</a></li><li class="nav-item" data-astro-cid-nen7h5rs><a href="/guides/" class="nav-link" data-astro-cid-nen7h5rs>Guides</a></li></ul></div></nav></header><!-- Mobile drawer: 320px panel from left + 0.42 dim scrim --><nav class="drawer" id="drawer" aria-label="Main menu" data-astro-cid-nen7h5rs><div class="dp" data-astro-cid-nen7h5rs><div class="dh" data-astro-cid-nen7h5rs><strong class="dh-title" data-astro-cid-nen7h5rs>Menu</strong><label class="dh-close" for="navt" aria-label="Close menu" tabindex="0" role="button" data-astro-cid-nen7h5rs><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-astro-cid-nen7h5rs><path d="M6 6l12 12M18 6 6 18" data-astro-cid-nen7h5rs></path></svg></label></div><div class="drawer-nav" data-astro-cid-nen7h5rs><a href="/" class="drawer-link active" aria-current="page" data-astro-cid-nen7h5rs>Home</a><a href="/fish/" class="drawer-link" data-astro-cid-nen7h5rs>Fish</a><a href="/items/" class="drawer-link" data-astro-cid-nen7h5rs>Items</a><a href="/upgrades/" class="drawer-link" data-astro-cid-nen7h5rs>Upgrades</a><a href="/map/" class="drawer-link" data-astro-cid-nen7h5rs>Map</a><a href="/news/" class="drawer-link" data-astro-cid-nen7h5rs>News</a><a href="/guides/" class="drawer-link" data-astro-cid-nen7h5rs>Guides</a></div><div id="drawer-account-slot" class="drawer-account-slot" data-astro-cid-nen7h5rs></div></div><label class="scrim" for="navt" aria-hidden="true" data-astro-cid-nen7h5rs></label></nav><script>
  (() => {
    const t = document.getElementById('navt');
    const b = document.querySelector('.burger');
    if (t && b) {
      const set = () => {
        b.setAttribute('aria-expanded', String(t.checked));
        if (t.checked) {
          const closeBtn = document.querySelector('.dh-close');
          if (closeBtn) closeBtn.focus();
        } else {
          b.focus();
        }
      };
      t.addEventListener('change', set);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && t.checked) {
          t.checked = false;
          set();
        }
        if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('label[role=button]')) {
          e.preventDefault();
          t.checked = !t.checked;
          set();
        }
      });
      const drawer = document.getElementById('drawer');
      if (drawer) {
        drawer.addEventListener('click', (e) => {
          if (e.target.closest('a')) {
            t.checked = false;
            set();
          }
        });
      }
    }

    const mq = window.matchMedia('(min-width: 992px)');
    const moveAccount = () => {
      const widget = document.getElementById('account-widget');
      const desk = document.getElementById('desk-account-slot');
      const drawer = document.getElementById('drawer-account-slot');
      if (!widget || !desk || !drawer) return;
      if (mq.matches) {
        if (!desk.contains(widget)) desk.appendChild(widget);
      } else {
        if (!drawer.contains(widget)) drawer.appendChild(widget);
      }
    };
    mq.addEventListener('change', moveAccount);
    moveAccount();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', moveAccount);
    }
  })();
</script><div class="ad-slot ad-slot-top" data-ad-slot="top"></div><main id="main-content"><div class="wrap not-found-wrap" data-astro-cid-ibpinaeu><div class="card not-found-card" data-astro-cid-ibpinaeu><span class="badge badge-news" data-astro-cid-ibpinaeu>404 Error</span><h1 data-astro-cid-ibpinaeu>Waters Uncharted</h1><p class="not-found-msg" data-astro-cid-ibpinaeu>The coordinates you entered lead into empty water. The page you are looking for has been moved, removed, or has not yet surfaced from the Submerged Lands.</p><div class="not-found-actions" data-astro-cid-ibpinaeu><a href="/" class="btn btn-primary" data-astro-cid-ibpinaeu>Return to Port (Home)</a><a href="/guides/" class="btn btn-secondary" data-astro-cid-ibpinaeu>Browse Guides</a></div></div></div></main><div class="ad-slot ad-slot-bottom" data-ad-slot="bottom"></div><footer class="site-footer" data-cc-slot data-astro-cid-jo6i4kqk><div class="wrap footer-inner" data-astro-cid-jo6i4kqk><div class="footer-meta" data-astro-cid-jo6i4kqk><p class="disclaimer" data-astro-cid-jo6i4kqk>Unofficial fan site, not affiliated with Dream Dock or Digital Vortex Entertainment.</p><p class="version-note" data-astro-cid-jo6i4kqk>Demo build 26140998.</p></div><nav class="footer-nav" aria-label="Footer Navigation" data-astro-cid-jo6i4kqk><ul class="footer-links" data-astro-cid-jo6i4kqk><li data-astro-cid-jo6i4kqk><a href="/about/" data-astro-cid-jo6i4kqk>About</a></li><li data-astro-cid-jo6i4kqk><a href="/contact/" data-astro-cid-jo6i4kqk>Contact</a></li><li data-astro-cid-jo6i4kqk><a href="/dmca/" data-astro-cid-jo6i4kqk>DMCA</a></li><li data-cc-slot data-astro-cid-jo6i4kqk><a href="/privacy/" data-astro-cid-jo6i4kqk>Privacy Policy</a></li></ul></nav></div></footer></body></html>